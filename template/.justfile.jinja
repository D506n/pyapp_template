# Run bootstrap explicitly after Copier copy.
bootstrap:
    uv lock
    uv sync --locked

lint:
    bash -n ci/security.sh
    uv run --locked ruff check .
    uv run --locked ruff format --check .

format-src:
    uv run --locked ruff format src{% if use_alembic and database != 'none' %} migrations{% endif %}

format-ci:
    uv run --locked ruff format ci

test-contract:
    uv run --locked pytest --tb=no --show-capture=no -o log_cli=false

security:
    bash ci/security.sh

test: test-contract

precommit-check-agent: lint test-contract security

run:
    uv run --locked python -m {{ package_name }}
{% if use_alembic and database != 'none' %}
# Set DATABASE_URL explicitly; inspect every generated revision before upgrade.
revision:
    uv run --locked alembic revision --autogenerate

upgrade:
    uv run --locked alembic upgrade head
{% endif %}
