# Запустите bootstrap явно после создания проекта.
bootstrap:
    uv lock
    uv sync --locked

lint:
    bash -n ci/security.sh
    uv run --locked ruff check .
    uv run --locked ruff format --check .

format-src:
    uv run --locked ruff format main.py config.py src{% if use_alembic and database != 'none' %} migrations{% endif %}

format-ci:
    uv run --locked ruff format ci

test-contract:
    uv run --locked python -m pytest --tb=no --show-capture=no -o log_cli=false

security:
    bash ci/security.sh

test: test-contract

precommit-check-agent: lint test-contract security

run:
    uv run --locked main.py
{% if use_alembic and database != 'none' %}
# Задайте DATABASE_URL явно; проверьте ревизию перед применением миграций.
revision:
    uv run --locked alembic revision --autogenerate

upgrade:
    uv run --locked alembic upgrade head
{% endif %}
