[project]
name = {{ ('app-' ~ (project_name | regex_replace('[^A-Za-z0-9]+', '-') | trim('-') | lower or 'app')) | tojson }}
version = "0.1.0"
description = {{ description | to_json(ensure_ascii=False) }}
authors = [{name = {{ author_name | to_json(ensure_ascii=False) }}}]
requires-python = ">=3.14,<3.15"
{% if project_license == 'MIT' %}
license = "MIT"
license-files = ["LICENSE", "THIRD_PARTY_NOTICES.md"]
{% else %}
license-files = ["THIRD_PARTY_NOTICES.md"]
{% endif %}
dependencies = [
{% if settings_backend == "magutils" or use_magutils %}
    "magutils",
{% endif %}
{% if use_http_api %}
    "fastapi>=0.121,<1",
{% endif %}
{% if use_http_api or (use_mcp and mcp_transport == 'http') %}
    "uvicorn>=0.38,<1",
{% endif %}
{% if use_mcp %}
    "fastmcp>=4.2,<5",
{% endif %}
{% if database != 'none' %}
    "sqlalchemy[asyncio]>=2.0.44,<3",
{% if database == 'postgresql' %}
    "asyncpg>=0.31,<1",
{% elif database == 'sqlite' %}
    "aiosqlite>=0.21,<1",
{% else %}
    "asyncmy>=0.2.10,<1",
{% endif %}
{% if use_alembic %}
    "alembic>=1.17,<2",
{% endif %}
{% endif %}
{% if settings_backend == 'pydantic_settings' %}
    "pydantic-settings>=2.11,<3",
{% endif %}
{% if use_http_client %}
    "httpx>=0.28,<1",
{% endif %}
]

[tool.uv]
package = false
{% if settings_backend == 'magutils' or use_magutils %}

[tool.uv.sources]
magutils = { git = "https://github.com/D506n/magutils", rev = "c54820bb9d782c70c6f6be52bf28860e48bfb4fb" }
{% endif %}

[dependency-groups]
dev = [
    "pytest>=8.4,<10", "pytest-asyncio>=1.2,<2", "httpx>=0.28,<1",
    "ruff>=0.14,<1", "bandit>=1.8,<2", "pip-audit>=2.9,<3",
]

[tool.ruff]
target-version = "py314"
line-length = 100
force-exclude = true
extend-exclude = ["tests", "test_*.py", "*_test.py", "conftest.py"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
