"""Explicit resource ownership shared by the selected transports."""

from collections.abc import AsyncGenerator
from contextlib import AsyncExitStack, asynccontextmanager

{% if use_http_client %}
import httpx

{% endif %}
from {{ package_name }}.config import Settings
{% if database != 'none' %}
from {{ package_name }}.database import create_engine, session_factory
{% endif %}


@asynccontextmanager
async def resources() -> AsyncGenerator[dict[str, object]]:
    settings = Settings()
    async with AsyncExitStack(){% if database != "none" or use_http_client %} as stack{% endif %}:
        state: dict[str, object] = {"settings": settings}
{% if database != 'none' %}
        engine = create_engine(settings.database_url)
        stack.push_async_callback(engine.dispose)
        state["engine"] = engine
        state["sessions"] = session_factory(engine)
{% endif %}
{% if use_http_client %}
        state["http_client"] = await stack.enter_async_context(
            httpx.AsyncClient(timeout=httpx.Timeout(10.0))
        )
{% endif %}
        yield state
