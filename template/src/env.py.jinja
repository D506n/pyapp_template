"""Настройки выбранного backend."""

{% if settings_backend == 'pydantic_settings' %}
from pydantic import Field
from pydantic_settings import BaseSettings, SettingsConfigDict
{% if use_http_api %}

from src.api.token import load_api_token
{% endif %}


class Settings(BaseSettings):
    model_config = SettingsConfigDict(hide_input_in_errors=True)

    host: str = "127.0.0.1"
    port: int = Field(default=8000, ge=1, le=65535)
{% if use_http_api %}
    api_token: str = Field(min_length=1, repr=False)
{% endif %}
{% if database != 'none' %}
    database_url: str = Field(default="", repr=False)
{% endif %}
{% if use_http_api %}

    def __init__(self, **data: object) -> None:
        if "api_token" not in data:
            data["api_token"] = load_api_token()
        super().__init__(**data)
{% endif %}
{% elif settings_backend == 'magutils' %}
from dataclasses import dataclass{% if database != "none" or use_http_api %}, field{% endif %}

{% if use_http_api %}
from functools import partial
{% endif %}

from magutils.env import EnvValidationError, environ
from magutils.env import field as env_field
{% if use_http_api %}
from magutils.env.main import new_token
{% endif %}


@environ()
class _NativeSettings:
    HOST: str = env_field("127.0.0.1")
    PORT: int = env_field(8000)
{% if use_http_api %}
    API_TOKEN: str = env_field(default_factory=partial(new_token, key="API_TOKEN", nbytes=16))
{% endif %}
{% if database != 'none' %}
    DATABASE_URL: str = env_field("")
{% endif %}


@dataclass(init=False)
class Settings:
    """Безопасное представление настроек; magutils кеширует первое чтение окружения."""

    host: str
    port: int
{% if use_http_api %}
    api_token: str = field(repr=False)
{% endif %}
{% if database != 'none' %}
    database_url: str = field(repr=False)
{% endif %}

    def __init__(self) -> None:
        try:
            native = _NativeSettings()
        except EnvValidationError:
            raise ValueError("Не удалось прочитать настройки окружения") from None
        self.host = native.HOST
        self.port = native.PORT
{% if use_http_api %}
        self.api_token = native.API_TOKEN
{% endif %}
{% if database != 'none' %}
        self.database_url = native.DATABASE_URL
{% endif %}
        if not 1 <= self.port <= 65535:
            raise ValueError("PORT должен быть от 1 до 65535")
{% else %}
import os
from dataclasses import dataclass{% if database != "none" or use_http_api %}, field{% endif %}

{% if use_http_api %}

from src.api.token import load_api_token
{% endif %}


@dataclass(init=False)
class Settings:
    host: str
    port: int
{% if use_http_api %}
    api_token: str = field(repr=False)
{% endif %}
{% if database != 'none' %}
    database_url: str = field(repr=False)
{% endif %}

    def __init__(self) -> None:
        self.host = os.getenv("HOST", "127.0.0.1")
{% if use_http_api %}
        self.api_token = load_api_token()
{% endif %}
        try:
            self.port = int(os.getenv("PORT", "8000"))
        except ValueError:
            raise ValueError("PORT должен быть целым числом от 1 до 65535") from None
        if not 1 <= self.port <= 65535:
            raise ValueError("PORT должен быть от 1 до 65535")
{% if database != 'none' %}
        self.database_url = os.getenv("DATABASE_URL", "")
{% endif %}
{% endif %}
