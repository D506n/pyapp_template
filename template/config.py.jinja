"""Ресурсы и общий жизненный цикл выбранных транспортов."""

from collections.abc import AsyncGenerator
from contextlib import AsyncExitStack, asynccontextmanager
{% if use_http_api %}

from fastapi import FastAPI
{% endif %}

{% if database != 'none' %}
from src.connectors.db.conn import create_engine, session_factory
{% endif %}
from src.env import Settings


@asynccontextmanager
async def resources() -> AsyncGenerator[dict[str, object]]:
    settings = Settings()
    async with AsyncExitStack(){% if database != "none" %} as stack{% endif %}:
        state: dict[str, object] = {"settings": settings}
{% if database != 'none' %}
        engine = create_engine(settings.database_url)
        stack.push_async_callback(engine.dispose)
        state["engine"] = engine
        state["sessions"] = session_factory(engine)
{% endif %}
        yield state
{% if use_mcp %}


@asynccontextmanager
async def mcp_lifespan(server: object) -> AsyncGenerator[dict[str, object]]:
    async with resources() as state:
        yield state
{% endif %}
{% if use_http_api %}


@asynccontextmanager
async def lifespan(application: FastAPI) -> AsyncGenerator[None]:
{% if use_mcp %}
    async with application.state.mcp_app.lifespan(application):
        yield
{% else %}
    async with resources() as state:
        application.state.resources = state
        yield
{% endif %}
{% endif %}
